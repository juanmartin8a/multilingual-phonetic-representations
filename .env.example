# Copy to .env.local; load with bun --env-file=.env.local. Never commit real credentials.
# Database connection and auth token for the SAPO Turso database.
TURSO_DATABASE_URL=libsql://YOUR-DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR-SECRET
# Non-secret AI settings belong in scripts/generators/config/*.yml.
# Cloudflare account > AI Gateway > Run; scope to your Cloudflare account.
CLOUDFLARE_API_TOKEN=YOUR-SECRET
# Store your OpenAI key in Cloudflare AI Gateway > Provider Keys (alias: default).
# No OPENAI_API_KEY is needed locally. OpenAI bills inference directly.
